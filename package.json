{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "description": "Unofficial macOS desktop wrapper for DeepSeek Harness",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "electron .",
    "build:icon": "node scripts/build-icon.mjs",
    "test": "node --test",
    "pack:mac": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never",
    "postinstall": "npm run build:icon && electron-builder install-app-deps"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "sharp": "0.34.4"
  },
  "build": {
    "appId": "com.richiechoo.deepseek-harness",
    "productName": "DeepSeek Harness",
    "asar": false,
    "files": [
      "src/**/*",
      "build/icon.icns",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "npmRebuild": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "DeepSeek-Harness-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "DeepSeek Harness ${version}",
      "sign": false,
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 420,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
